      "image": "./assets/images/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#060A0C"
    },
    "ios": {
      "supportsTablet": true,
      "infoPlist": {
        "NSCameraUsageDescription": "MedVault uses the camera to scan drug barcodes when you add stock."
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#060A0C",
        "foregroundImage": "./assets/images/icon.png"
      },
      "permissions": [
        "CAMERA"
      ],
      "package": "com.medvaultapp.medvault"
    },
    "web": {
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      [
        "expo-camera",
        {
          "cameraPermission": "MedVault uses the camera to scan drug barcodes when you add stock.",
          "microphonePermission": false,
          "recordAudioAndroid": false
        }
      ],
      "expo-font"
    ],
    "extra": {
      "eas": {
        "projectId": "72154a75-0fc5-4790-bce3-c0445e887b3a"
      },
      "EXPO_PUBLIC_API_URL": "https://med-vault-backend-i9v7.onrender.com/api"
    },
    "owner": "medvaultapp"
  }
}
