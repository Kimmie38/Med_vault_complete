{
  "expo": {
    "name": "MedVault",
    "slug": "medvault-bwqtkt7xd9go2cota-tqm",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "userInterfaceStyle": "automatic",
    "backgroundColor": "#060A0C",
